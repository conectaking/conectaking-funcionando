# Conecta King — full PHP (Laravel + FrankenPHP). Ignore Node leftovers.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
!laravel/package-lock.json

# Laravel
laravel/vendor/
laravel/node_modules/
laravel/.env
laravel/storage/*.key
laravel/storage/logs/*
laravel/storage/framework/cache/*
laravel/storage/framework/sessions/*
laravel/storage/framework/views/*
!laravel/storage/logs/.gitignore
!laravel/storage/framework/cache/.gitignore
!laravel/storage/framework/sessions/.gitignore
!laravel/storage/framework/views/.gitignore

# Secrets / env
.env
.env.path
.env.local
.env.*.local
.env.docker
.env.prod
.env.production
backups/
*.dump
*.tgz
*.tar
*.zip

# Logs / OS / IDE
logs/
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Local uploads / cache / tmp
uploads/
public/uploads/
.cache/
tmp/
temp/
*.tmp
orfas-*.json

# public_html: espelho legado Hostinger (assets). Páginas canónicas = Blade.
# Mantém-se no disco do VPS; no git só o necessário (ou nada).
public_html/
!public_html/.gitkeep
