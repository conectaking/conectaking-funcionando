# Copie para .env.docker e ajuste se quiser:
#   copy .env.docker.example .env.docker
#
# Depois:
#   docker compose --env-file .env.docker up --build

# --- App ---
# Porta no seu PC (mapeada para 5000 dentro do container)
PORT=5000
NODE_ENV=development

# Obrigatório para a API iniciar (pode ser qualquer string no local)
JWT_SECRET=conectaking-local-dev-secret-change-me
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- Postgres (serviço "db" do compose) ---
POSTGRES_USER=conectaking
POSTGRES_PASSWORD=conectaking
POSTGRES_DB=conectaking
POSTGRES_PORT=5432

# DATABASE_URL é montada automaticamente no compose apontando para o host "db".
# SSL desligado no compose (DATABASE_SSL=false) — necessário no Docker local.
