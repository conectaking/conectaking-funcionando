# ==============================================================================
# ARQUIVO DE CONFIGURAÃ‡ÃƒO CONECTA KING (v2 - com URLs AmigÃ¡veis)
# ==============================================================================

# PÃ¡gina inicial (espelho de public_html/.htaccess na Hostinger)
DirectoryIndex index.html index.php

# FORÃ‡AR CODIFICAÃ‡ÃƒO UTF-8
# ------------------------------------------------------------------------------
AddDefaultCharset UTF-8

# REGRAS DE REESCRITA DE URL
# ------------------------------------------------------------------------------
RewriteEngine On
RewriteBase /

# Favicon: o browser pede /favicon.ico por defeito â€” redireciona para o logo jÃ¡ usado no site (evita 404 no console)
RewriteRule ^favicon\.ico$ https://i.ibb.co/60sW9k75/logo.png [R=302,L]

# FORÃ‡AR HTTPS (CONEXÃƒO SEGURA)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# REDIRECIONAR "dominio.com" PARA "www.dominio.com"
RewriteCond %{HTTP_HOST} ^conectaking.com.br [NC]
RewriteRule ^(.*)$ https://www.conectaking.com.br/$1 [L,R=301,NC]

# Painel BÃ­blia (mÃ³dulo): a pÃ¡gina real corre no Node (Render). Tem prioridade sobre as regras de
# "URL limpa" abaixo â€” senÃ£o bible.html vira /bible e facilmente dÃ¡ 404 se o ficheiro nÃ£o existir no Hostinger.
RewriteRule ^bible\.html$ https://www.conectaking.com.br/bible.html [R=302,L,QSA]
RewriteRule ^bibliaking\.html$ https://www.conectaking.com.br/bibliaking.html [R=302,L,QSA]
RewriteRule ^bible/?$ https://www.conectaking.com.br/bible.html [R=302,L,QSA]
RewriteRule ^bibliaking/?$ https://www.conectaking.com.br/bibliaking.html [R=302,L,QSA]

# 1. Redireciona o usuÃ¡rio que acessa "pagina.html" para a versÃ£o limpa "pagina"
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# 2. King Selection (evitar que /kingSelection vire kingSelection.html inexistente â†’ 404)
#    Com slug: PHP injeta Open Graph (capa WhatsApp) e envia o mesmo HTML que kingSelectionCliente.html.
#    Requer PHP. Sem PHP, volte a kingSelectionCliente.html
#    Painel: /kingSelection/kingSelectionProject.html â†’ ficheiro na raiz (nÃ£o confundir com slug da galeria)
RewriteRule ^kingSelection/kingSelectionProject\.html$ kingSelectionProject.html [L,QSA,NC]
RewriteRule ^kingSelection/kingSelectionEdit\.html$ kingSelectionEdit.html [L,QSA,NC]
RewriteRule ^kingSelection/kingSelectionCliente\.html$ kingSelectionCliente.html [L,QSA,NC]
RewriteRule ^kingSelection/kingSelectionGallery\.html$ kingSelectionGallery.html [L,QSA,NC]
RewriteRule ^kingSelection/kingSelectionReview\.html$ kingSelectionReview.html [L,QSA,NC]
RewriteRule ^kingSelection/kingSelectionSuccess\.html$ kingSelectionSuccess.html [L,QSA,NC]
RewriteCond %{REQUEST_URI} !\.(css|js|mjs|map|json|woff2?|ttf|eot|svg|png|jpe?g|gif|ico|webp|html|htm)$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^kingSelection/([^/]+)/?$ kingSelectionGallery.php?ks_slug=$1 [L,NC,QSA]
# Compatibilidade: links antigos /kingSelectionEdit?itemId=... -> /kingSelection
RewriteRule ^kingSelectionEdit(?:\.html)?/?$ /kingSelection [R=302,L,NC,QSA]
# Compatibilidade: pÃ¡ginas legadas do projeto (layout antigo) -> painel oficial
RewriteRule ^(?:ring|rings|king)selectionproject(?:\.html)?/?$ /kingSelection [R=302,L,NC,QSA]
# Compatibilidade com prefixo legado /mr/
RewriteRule ^mr/kingSelectionEdit(?:\.html)?/?$ /kingSelection [R=302,L,NC,QSA]
RewriteRule ^mr/(?:ring|rings|king)selectionproject(?:\.html)?/?$ /kingSelection [R=302,L,NC,QSA]
# Compatibilidade ampla: qualquer variante legacy selection(edit|project)
RewriteRule ^(?:mr/)?(?:ring|rings|king)selection(?:edit|project)(?:\.html)?/?$ /kingSelection [R=302,L,NC,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^kingSelection/?$ kingSelectionEdit.html [L,QSA,NC]

# 3. Pega uma URL limpa e entrega o arquivo .html correspondente (COM CORREÃ‡ÃƒO)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.(?:css|js|jpe?g|gif|png|svg|ico)$ [NC]
RewriteRule ^(.*)$ $1.html [L]


# OTIMIZAÃ‡ÃƒO DE CACHE NO NAVEGADOR
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  # CSS e JS com NO-CACHE para desenvolvimento (forÃ§ar atualizaÃ§Ã£o)
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType application/x-javascript "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# FORÃ‡AR NO-CACHE PARA ARQUIVOS DE DESENVOLVIMENTO
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # ForÃ§ar no-cache para arquivos CSS (sempre buscar versÃ£o atualizada)
    <FilesMatch "\.(css)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    
    # ForÃ§ar no-cache para arquivos JavaScript (sempre buscar versÃ£o atualizada)
    <FilesMatch "\.(js)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    
    # ForÃ§ar no-cache para arquivos HTML (sempre buscar versÃ£o atualizada)
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    
    # Desabilitar cache para arquivos especÃ­ficos crÃ­ticos
    <FilesMatch "^(salesPageEdit\.html|dashboard\.html|dashboard\.products\.js|salesPageEdit\.js|salesPageEdit\.css|dashboard\.js|dashboard\.css)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
        Header set Last-Modified "Thu, 01 Jan 1970 00:00:00 GMT"
    </FilesMatch>

    <FilesMatch "^(config\.js|kingSelection.*\.(html|js))$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>
</IfModule>

# COMPRESSÃƒO DE ARQUIVOS
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
  AddOutputFilterByType DEFLATE application/x-font
  AddOutputFilterByType DEFLATE application/x-font-opentype
  AddOutputFilterByType DEFLATE application/x-font-truetype
  AddOutputFilterByType DEFLATE application/x-font-ttf
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE image/x-icon
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
</IfModule>