{
  "name": "CK Agent — Alerta Health Telegram",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] }
      },
      "id": "cron01",
      "name": "A cada 5 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://www.conectaking.com.br/health",
        "options": { "timeout": 10000 }
      },
      "id": "http01",
      "name": "GET Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if01",
      "name": "Health ruim?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $env.ADMIN_TELEGRAM_ID }}",
        "text": "={{ '🚨 Alerta Conecta King\\n/health não está ok.\\nResposta: ' + JSON.stringify($json).slice(0,500) }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "tg01",
      "name": "Avisar Admin TG",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [740, 200]
    }
  ],
  "connections": {
    "A cada 5 min": {
      "main": [[{ "node": "GET Health", "type": "main", "index": 0 }]]
    },
    "GET Health": {
      "main": [[{ "node": "Health ruim?", "type": "main", "index": 0 }]]
    },
    "Health ruim?": {
      "main": [
        [{ "node": "Avisar Admin TG", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": false }
}
