# --- Proxy residencial BR (obrigatório se WhatsApp bloquear IP da VPS) ---
# Exemplos de formato do provedor: host:porta:user:pass  ou  host / porta / user / pass
# Preferir: residencial Brasil, HTTP ou SOCKS5
EVO_PROXY_ENABLED=false
EVO_PROXY_HOST=
EVO_PROXY_PORT=
EVO_PROXY_PROTOCOL=http
EVO_PROXY_USERNAME=
EVO_PROXY_PASSWORD=
