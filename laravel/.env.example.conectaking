# Laravel (cartão virtual) — variáveis usadas pelo docker-compose
# Gere a chave com: docker run --rm -v "$PWD/laravel:/app" -w /app php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
LARAVEL_APP_KEY=
LARAVEL_CARD_ENABLED=true

# Copiar APP_KEY para .env.prod (não commitar):
# LARAVEL_APP_KEY=base64:...
