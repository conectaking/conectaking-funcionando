# Copiar para /opt/conectaking/.env.prod (NÃO commitar segredos).
# Compose: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- Obrigatórias ---
# Gerar: docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
LARAVEL_APP_KEY=
JWT_SECRET=
POSTGRES_PASSWORD=
POSTGRES_USER=conectaking
POSTGRES_DB=conectaking

# --- Runtime (compose já força a maioria; deixe alinhado) ---
QUEUE_CONNECTION=redis
REDIS_PASSWORD=
LOG_LEVEL=warning
TRUSTED_PROXIES=*
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_IP_ALLOWLIST=
SENTRY_LARAVEL_DSN=
CK_BACKUP_OFFBOX_CMD=
# false = Gestão Financeira normal no menu (ocultar só via separação de pacotes)
FINANCE_MODULE_STANDBY=false

# --- App / URLs ---
PUBLIC_APP_URL=https://www.conectaking.com.br
LARAVEL_CARD_ENABLED=true

# --- OCR recibos (Vision; tesseract removido da imagem prod — use always/never) ---
OPENAI_API_KEY=
RECIBO_OCR_AI=always
RECIBO_OCR_AI_MODEL=gpt-4o-mini

# --- E-mail (opcional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@conectaking.com.br
SMTP_SECURE=false

# --- Push (opcional) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- King Selection / R2 / Rekognition (conforme worker e face) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# S3_STAGING_BUCKET=
# REKOG_COLLECTION_ID=
# KINGSELECTION_WORKER_SECRET=
